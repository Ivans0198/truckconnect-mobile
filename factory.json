{
  "stack": "expo-rn",
  "commands": {
    "install": ["pnpm", "install", "--frozen-lockfile"],
    "lint": ["pnpm", "lint"],
    "typecheck": ["pnpm", "typecheck"],
    "test": ["pnpm", "test"],
    "build": ["pnpm", "build"],
    "e2e": ["pnpm", "e2e"],
    "dev": ["pnpm", "exec", "expo", "start", "--web", "--port", "3741"],
    "androidBuild": ["pnpm", "build:android"],
    "androidServe": [
      "pnpm",
      "exec",
      "expo",
      "start",
      "--dev-client",
      "--port",
      "8081"
    ],
    "androidE2e": ["pnpm", "e2e:android"]
  },
  "appUrl": "http://localhost:3741",
  "factoryEpic": null,
  "docLang": "es",
  "commitFormat": "conventional",
  "format": [
    {
      "extensions": ["ts", "tsx", "js", "jsx", "json", "md"],
      "cmd": ["pnpm", "exec", "prettier", "--write"]
    },
    {
      "extensions": ["ts", "tsx", "js", "jsx"],
      "cmd": ["pnpm", "exec", "eslint", "--fix"]
    }
  ],
  "models": {
    "worker": "sonnet",
    "codeReviewer": "sonnet",
    "uiReviewer": "opus",
    "planning": "opus"
  },
  "review": {
    "uiReview": "label"
  },
  "extraPlugins": [
    {
      "id": "expo@claude-plugins-official",
      "marketplace": "https://github.com/anthropics/claude-plugins-official.git",
      "ref": "0fbfda5a91f4adc311daca25acc99132f40f0b6e",
      "domains": ["mcp.expo.dev"]
    }
  ],
  "androidApk": "android/app/build/outputs/apk/debug/app-debug.apk"
}
